<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main">

    <!-- Top Shape -->
    <View android:id="@+id/topShape" style="@style/TopShape" android:layout_width="0dp" android:layout_height="190dp" android:alpha="0.18" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Header -->
    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView android:id="@+id/scrollContent" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:paddingStart="18dp" android:paddingTop="6dp" android:paddingEnd="18dp" android:paddingBottom="28dp" android:scrollbars="none" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:id="@+id/headerLayout" style="@style/Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:id="@+id/backContainer" style="@style/BackBtn.Box" android:layout_marginBottom="16dp" android:orientation="horizontal">

            <ImageView android:id="@+id/btnBack" style="@style/BackBtn.Icon" android:contentDescription="Back"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                <TextView android:id="@+id/txtTitle" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose Challenge Type"/>

                <TextView android:id="@+id/txtSubtitle" style="@style/Text.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose the right challenge for today and start your child's progress step by step."/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Motor Challenge Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardMotor" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Card.Padding">

                    <LinearLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_chip_challenge" android:gravity="center">

                        <ImageView style="@style/Icon.Category" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/motortype"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">

                        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Motor Challenge"/>

                        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Activities that help your child improve movement skills, coordination, and balance."/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/btn_primary" android:textSize="28sp" android:alpha="0.6" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language Challenge Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardLanguage" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Card.Padding">

                    <LinearLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_chip_challenge" android:gravity="center">

                        <ImageView style="@style/Icon.Category" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/languagetype"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">

                        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Language Challenge"/>

                        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Activities that support language development, communication, and understanding."/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/btn_primary" android:textSize="28sp" android:alpha="0.6" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Speech Challenge Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSpeech" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Card.Padding">

                    <LinearLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_chip_challenge" android:gravity="center">

                        <ImageView style="@style/Icon.Category" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/speechtype"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">

                        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speech Challenge"/>

                        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Activities to improve pronunciation and help your child produce sounds more clearly."/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/btn_primary" android:textSize="28sp" android:alpha="0.6" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tip Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/tipCard" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
