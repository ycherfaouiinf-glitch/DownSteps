<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/languagePage" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main">

    <!-- Top background -->
    <View android:id="@+id/topShape" style="@style/TopShape" android:layout_width="0dp" android:layout_height="140dp" android:alpha="0.45" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Header -->
    <!-- Content -->
    <ScrollView android:id="@+id/scrollContent" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="16dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:id="@+id/headerLayout" style="@style/Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:id="@+id/backContainer" style="@style/BackBtn.Box" android:layout_marginBottom="14dp" android:orientation="horizontal">

            <ImageView android:id="@+id/btnBack" style="@style/BackBtn.Icon" android:contentDescription="Back"/>
        </LinearLayout>

        <TextView android:id="@+id/tvLanguageTitle" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Language"/>

        <TextView android:id="@+id/tvLanguageSubtitle" style="@style/Text.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose your preferred language"/>
    </LinearLayout>

    <!-- Language Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/languageCard" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                    <TextView android:id="@+id/tvAppLanguage" style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="App Language"/>

                    <RadioGroup android:id="@+id/radioGroupLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                        <RadioButton android:id="@+id/rbEnglish" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="English" style="@style/Radio" app:buttonTint="@color/btn_primary"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/input_border"/>

                        <RadioButton android:id="@+id/rbArabic" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="العربية" style="@style/Radio" app:buttonTint="@color/btn_primary"/>
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveLanguage" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
