<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top background -->
    <View
        android:id="@+id/topShape"
        style="@style/TopShape"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:alpha="0.22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="110dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Header -->
            <LinearLayout
                android:id="@+id/headerLayout"
                style="@style/Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back" />

                <TextView
                    android:id="@+id/tvParentName"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/parent_name"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    style="@style/Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/support_child" />
            </LinearLayout>
            <!-- Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/welcomeCard"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp" />

            <!-- Section title -->
            <TextView
                android:id="@+id/tvExploreTitle"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/explore_features" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFaq"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/faq"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/faq_info"
                            android:textAlignment="center" />

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/faq_description"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChallenges"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/challanges"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/challenges"/>

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/challenges_description"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSkills"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/dailychallanges"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/daily_skills"/>

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/games_description"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCenters"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_mylocation"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/centers"/>

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/centers_description" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGames"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/game"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/games"/>

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/games_description" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuccessStories"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|center_horizontal"
                        android:minHeight="175dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:alpha="0.20"
                                android:background="@drawable/circle_child_bg" />

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/succes"
                                app:tint="@color/btn_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/success_stories" />

                        <TextView
                            style="@style/Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/success_stories_description" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Audio Library -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAudioLibrary"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|center_horizontal"
                    android:minHeight="160dp"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <View
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:alpha="0.20"
                            android:background="@drawable/circle_child_bg" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/voix"
                            app:tint="@color/btn_primary" />
                    </FrameLayout>

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/audio_library"/>

                    <TextView
                        style="@style/Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/audio_library_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
