<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/challengesTimelinePage" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main">

    <View android:id="@+id/topShape" style="@style/TopShape" android:layout_width="0dp" android:layout_height="140dp" android:alpha="0.22" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView android:id="@+id/scrollContent" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:paddingBottom="110dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <LinearLayout android:id="@+id/headerLayout" style="@style/Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:id="@+id/backContainer" style="@style/BackBtn.Box" android:layout_marginBottom="14dp">

            <ImageView android:id="@+id/btnBack" style="@style/BackBtn.Icon" android:contentDescription="Back"/>
        </LinearLayout>

        <TextView android:id="@+id/tvTimelineTitle" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Challenges"/>

        <TextView android:id="@+id/tvTimelineSubtitle" style="@style/Text.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Complete challenges to unlock new ones"/>
    </LinearLayout>

    <TextView android:id="@+id/txtType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:background="@drawable/bg_chip_timeline" android:padding="10dp" style="@style/Text.Small" android:text="Motor Challenge" android:textColor="@color/btn_primary" android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerChallenges" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
